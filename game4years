// Lluvia de confeti al ganar el trofeo
función launchConfetti() {
const canvas = document.getElementById('confetti-canvas');
const ctx = canvas.getContext('2d');
ancho del lienzo = ancho interior de la ventana;
lienzo.altura = ventana.alturainterior;

const pieces = Array.from({ length: 90 }, () => ({
x: Math.random() * canvas.width,
y: Math.random() * canvas.height - canvas.height,
tamaño: Math.random() * 8 + 5,
speedY: Math.random() * 4 + 2,
velocidadX: (Math.random() - 0.5) * 3,
color: ['#ff6b81', '#2ed573', '#ffa502', '#1e90ff', '#a55eea'][Math.floor(Math.random() * 5)]
}));

sea ​​frames = 0;
función animar() {
ctx.clearRect(0, 0, canvas.width, canvas.height);
piezas.forEach(p => {
py += p.speedY;
px += p.speedX;
ctx.fillStyle = p.color;
ctx.fillRect(px, py, p.size, p.size);
});
fotogramas++;
si (fotogramas < 180) {
requestAnimationFrame(animate);
} demás {
ctx.clearRect(0, 0, canvas.width, canvas.height);
}
}
animar();
}
